# Created automatically by start.bat / start.sh (or: copy to .env and run ./scripts/init-env.sh).
# Never commit .env.
CR_ENVIRONMENT=development

# MySQL 8.4 LTS (the only supported relational database)
MYSQL_DATABASE=cyber_range
MYSQL_USER=cyber_range
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3306

REDIS_HOST_PORT=6379
# Redis requires this password (filled automatically by start.bat / start.sh / scripts/init-env.sh)
REDIS_PASSWORD=
FRONTEND_PORT=8080
# Alamat yang didengar web UI. Biarkan 127.0.0.1 (hanya komputer ini). vm/install.sh memakai 0.0.0.0 di dalam VM-nya sendiri.
FRONTEND_BIND=127.0.0.1

# >= 32 random characters
CR_JWT_SECRET=
# Set true when served over HTTPS
CR_COOKIE_SECURE=false
# Local edition: the single operator session is only issued to requests for these hosts (browser on this computer)
CR_LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Optional: require a local access token for the operator session, so other programs on this computer cannot open one.
# Fill with a random value of 24+ letters/digits (or run: scripts/init-env.sh --with-local-token). start.bat opens the
# browser with the token; on Linux/macOS open http://localhost:8080/#cr-token=<value> once, the browser keeps it.
CR_LOCAL_ACCESS_TOKEN=

# Group id owning /var/run/docker.sock on the lab host (scripts/init-env.sh fills it in)
# Compose profiles to start by default (comma separated): lab, demo, dev, sensors. See docker-compose.yml.
COMPOSE_PROFILES=lab
# Host interface Suricata/Zeek sniff in the sensors profile
SENSOR_INTERFACE=eth0
DOCKER_GID=
# Lab runtime: docker (default) or fake (in-memory, for demos without Docker)
CR_LAB_DRIVER=docker

# Malware sandbox for dynamic analysis: none (default, disabled) or cape (external isolated CAPEv2, network routing disabled per task)
CR_SANDBOX_PROVIDER=none
CR_SANDBOX_URL=
CR_SANDBOX_TOKEN=

# --- Threat-intel feed secrets (optional). A feed in the UI refers to one of these names. ---
CR_FEED_MISP_KEY=
CR_FEED_TAXII_TOKEN=
CR_FEED_KEY_1=
CR_FEED_KEY_2=
# Allow feeds on private/LAN addresses (e.g. an internal MISP server)
CR_INTEL_FEED_ALLOW_PRIVATE=false

# ---- VM nodes (VM-WINDOWS.md di folder aplikasi). none = VM nodes run as hardened containers.
CR_VM_PROVIDER=none
# libvirt/KVM: build the backend with WITH_LIBVIRT=1 and use docker-compose.vm-libvirt.yml
CR_LIBVIRT_IMAGES=
# Proxmox VE (API token with VM.Allocate/VM.Clone/VM.Config.*/VM.PowerMgmt/VM.Snapshot on the pool only)
CR_PROXMOX_URL=
CR_PROXMOX_NODE=
CR_PROXMOX_TOKEN_ID=
CR_PROXMOX_TOKEN_SECRET=
CR_PROXMOX_BRIDGE=
CR_PROXMOX_VLAN_RANGE=
CR_PROXMOX_TEMPLATES=

# SOC SLA targets, minutes to acknowledge/resolve per severity (empty = defaults critical=15/240;high=30/480;medium=120/1440;low=480/4320;info=1440/10080)
CR_SLA_TARGETS=

# Lab Kit: Vagrant boxes allowed in downloadable kits. VM nodes with vm_template=<name> use that box; every other
# host uses "default". Only owner/name box ids are accepted.
CR_KIT_VAGRANT_BOXES=default=bento/ubuntu-24.04
# Lab Kit option "DC Windows" (template Kantor dengan Active Directory): Windows Server Evaluation box for dc01.
CR_KIT_WINDOWS_DC_BOX=gusztavvargadr/windows-server-2022-standard
# Lab Kit option "Windows 11" per employee PC (needs the Windows DC option): Windows 11 Evaluation box.
CR_KIT_WINDOWS_PC_BOX=gusztavvargadr/windows-11
